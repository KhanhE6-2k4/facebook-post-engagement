# Copy file này thành .env rồi điền giá trị. KHÔNG commit .env.
# Chỉ cần đặt MỘT trong hai biến dưới (ưu tiên GOOGLE_SERVICE_ACCOUNT_CREDENTIALS nếu có cả hai).

# Cách 1: đường dẫn tới file JSON key của service account (tiện khi chạy local)
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS_PATH=./credentials.json

# Cách 2: toàn bộ nội dung file JSON trên MỘT dòng, đặt trong dấu nháy đơn (tiện khi deploy)
# GOOGLE_SERVICE_ACCOUNT_CREDENTIALS='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","token_uri":"https://oauth2.googleapis.com/token"}'

# Proxy residential cho request tới Facebook (tùy chọn). Để trống = web báo "proxy chưa được hỗ trợ" khi chọn "Có".
# Dạng: http://USERNAME:PASSWORD@host:port
FB_PROXY_URL=

# Cổng chạy local (nền tảng deploy thường tự cấp PORT)
PORT=5000
